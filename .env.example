# Proveedor de IA: gemini (por defecto) u openai. Solo se lee en el servidor (src/lib/plan/generate.ts).
AI_PROVIDER=gemini

# Claves. Basta con la del proveedor elegido; nunca llegan al navegador.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Modelo por proveedor. Opcional.
# GEMINI_MODEL=gemini-flash-lite-latest
# OPENAI_MODEL=gpt-4o-mini

# Solo desarrollo: responde con un plan de ejemplo sin llamar al proveedor (ni gastar saldo).
# PLAN_MOCK=1
